# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && $EDITOR .env
#
# Prefer the macOS Keychain over this file for the three secrets:
#   ./scripts/secrets.sh set jira-api-token
# See config/secrets.md.

# ---- non-secret config (safe, already recorded in docs/) ----
JIRA_BASE_URL=https://1337software.atlassian.net
JIRA_PROJECT_KEY=SONAR
SONAR_ORG=phix
SONAR_PROJECT_KEY=phix_sonar-sandbox-app
GITHUB_SANDBOX_REPO=phix/sonar-sandbox-app

# ---- secrets: never commit, never paste into chat ----
# Atlassian login email for the 1337software site (a credential half)
JIRA_USER_EMAIL=1337.geek@gmail.com
# id.atlassian.com/manage-profile/security/api-tokens  (classic, unscoped)
JIRA_API_TOKEN=
# SonarQube Cloud > My Account > Security. Analysis-scoped.
SONAR_TOKEN=
# Separate read-only token for recon. See docs/research/api-contracts.md §1.
SONAR_TOKEN_READ=
# Teams Power Automate Workflows URL (see issue #2)
TEAMS_WEBHOOK_URL=

# ---- agentic fix endpoint (Ollama on tinman); only used when no codemod exists ----
# OpenAI-compatible: POST $LLM_BASE_URL/chat/completions, bearer auth. Ollama
# serves that surface, so the client needs no change to talk to it.
#
# tinman is LAN/tailnet-only. From a laptop on the same network the name is
# enough; from CI the job joins the tailnet first. See
# docs/decisions/llm-endpoint-transport.md.
LLM_BASE_URL=http://tinman:11434/v1
# The only model pulled on tinman as of 2026-08-30. Re-read the list before
# changing it -- a wrong id is a 404 the client classifies as persistent, which
# reads as a broken endpoint rather than a typo:
#   curl -s http://tinman:11434/v1/models
LLM_MODEL=qwen2.5-coder:14b
# NOT a credential. Ollama ignores bearer auth; this exists only because
# configFromEnv refuses to run with any of the three unset. Any non-empty
# string works. It stays required so the guard is already in place the day
# this points at an endpoint that does need a real key.
LLM_API_KEY=tinman-local-unauthenticated
