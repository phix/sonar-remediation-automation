# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && $EDITOR .env
#
# Prefer the macOS Keychain over this file for the three secrets:
#   ./scripts/secrets.sh set jira-api-token
# See config/secrets.md.

# ---- non-secret config (safe, already recorded in docs/) ----
JIRA_BASE_URL=https://1337software.atlassian.net
JIRA_PROJECT_KEY=SONAR
SONAR_ORG=phix
SONAR_PROJECT_KEY=phix_sonar-sandbox-app
GITHUB_SANDBOX_REPO=phix/sonar-sandbox-app

# ---- secrets: never commit, never paste into chat ----
# Atlassian login email for the 1337software site (a credential half)
JIRA_USER_EMAIL=1337.geek@gmail.com
# id.atlassian.com/manage-profile/security/api-tokens  (classic, unscoped)
JIRA_API_TOKEN=
# SonarQube Cloud > My Account > Security. Analysis-scoped.
SONAR_TOKEN=
# Separate read-only token for recon. See docs/research/api-contracts.md §1.
SONAR_TOKEN_READ=
# Teams Power Automate Workflows URL (see issue #2)
TEAMS_WEBHOOK_URL=

# ---- agentic fix endpoint (Nick's OpenLLM); only used when no codemod exists ----
# Assumed OpenAI-compatible: POST $LLM_BASE_URL/chat/completions, bearer auth.
LLM_BASE_URL=
LLM_MODEL=
# secret:
LLM_API_KEY=
